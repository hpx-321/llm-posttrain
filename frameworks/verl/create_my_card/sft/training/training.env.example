# Copy this file outside the repository, adjust it, then source it before training/run_sft.sh.

export MODEL_PATH=/mnt/model/Qwen3.6-27B
export DATA_DIR=/workspace/hql/llm-posttrain/frameworks/verl/create_my_card/sft/data/parquet
export SAVE_PATH=/mnt/model/qwen36-27b-create-my-card-sft-v1

# Existing Qwen3.6 environment in this repository uses Ascend NPU.
# Use TRAIN_DEVICE=cuda on a CUDA veRL environment.
export TRAIN_DEVICE=npu
export NPROC_PER_NODE=16
export MASTER_ADDR=127.0.0.1
export MASTER_PORT=29500

# Current token report: observed max=5501, aligned max length=5632.
# veRL dynamic batching starts with a per-device token budget of 2 x max length.
export MAX_LENGTH=5632
export MAX_TOKEN_LEN_PER_GPU=11264
export SP_SIZE=1

export MICRO_BATCH_SIZE_PER_GPU=1
export TRAIN_BATCH_SIZE=32

# Enable one at a time only after a worst-case dry run reports OOM.
export ACTIVATION_OFFLOAD=false
export OPTIMIZER_OFFLOAD=false
export PARAM_OFFLOAD=false

export TOTAL_EPOCHS=3
export MAX_CKPT_TO_KEEP=1
# Save only when val/loss improves by more than this value.
export BEST_CKPT_MIN_DELTA=0
export LEARNING_RATE=1e-6

# run_sft.sh writes TensorBoard events here and starts/reuses the shared dashboard.
export TENSORBOARD_DIR=/mnt/data/logs/verl_create_my_card_sft_1
export TENSORBOARD_HOST=0.0.0.0
export TENSORBOARD_PORT=6006

# Keep the default dry run until the longest-sample OOM probe succeeds.
# Dry run executes two steps without writing checkpoints or model weights.
export DRY_RUN=1
export DRY_RUN_STEPS=2
